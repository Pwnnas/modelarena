# Model Arena — environment template.
# Copy this file to .env and fill in what you use. .env is gitignored.

# OpenRouter — set a key to enable the OpenRouter provider in the Run view.
# Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Local / custom OpenAI-compatible server (llama-server, Ollama, LM Studio, vLLM).
# Default base URL for the "Local / custom server" provider.
ARENA_BASE_URL=http://localhost:8080/v1

# Optional API key for the local/custom server. Leave empty if it doesn't need
# one — the arena still tries to connect, list models and run without a key.
ARENA_API_KEY=